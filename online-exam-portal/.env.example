# API base URL (without trailing slash)
REACT_APP_API_BASE_URL=http://localhost:8081/api

# Auth bypass (development/demo only - never enable for production builds).
# When true the UI skips the login screen and pretends a fake user is signed in.
# Pair with AUTH_BYPASS=true on the API or every request will get a 401.
REACT_APP_AUTH_BYPASS=false
